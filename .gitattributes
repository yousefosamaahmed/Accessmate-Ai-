# AccessMate AI line-ending policy

* text=auto

*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.ps1  text eol=crlf

*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.svg  text eol=lf
*.pdf  binary
*.mp3  binary
*.wav  binary
*.webm binary
